<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingBottom="6dp">
    <TextView android:id="@+id/r_time" android:layout_width="46dp" android:layout_height="wrap_content"
        android:fontFamily="@font/plex_hebrew_semibold" android:gravity="end" android:maxLines="1" android:paddingEnd="8dp" android:textSize="12sp" />
    <LinearLayout android:id="@+id/r_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:background="@drawable/widget_card_night_dark" android:gravity="center_vertical" android:minHeight="44dp"
        android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="4dp">
        <LinearLayout android:id="@+id/r_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:id="@+id/r_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:fontFamily="@font/plex_hebrew_medium" android:maxLines="1" android:textSize="14sp" />
            <TextView android:id="@+id/r_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:fontFamily="@font/plex_hebrew_regular" android:maxLines="1" android:textSize="11sp" />
        </LinearLayout>
        <ImageView android:id="@+id/r_tick" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" />
    </LinearLayout>
</LinearLayout>
