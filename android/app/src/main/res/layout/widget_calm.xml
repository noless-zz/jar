<?xml version="1.0" encoding="utf-8"?>
<!-- Tasks widget, Calm: the date and a greeting, "+ Task" and the mic, a soft progress bar, rows in one card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="14dp" android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:id="@+id/w_head" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/heebo" android:maxLines="1" android:textColor="#5B6660" android:textSize="12sp" />
            <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/heebo" android:maxLines="1" android:ellipsize="end" android:text="@string/tasks_title"
                android:textColor="#1C2420" android:textSize="18sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/w_add" android:layout_width="wrap_content" android:layout_height="36dp"
            android:layout_marginEnd="8dp" android:background="@drawable/widget_pill_calm_light" android:fontFamily="@font/heebo"
            android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/w_add"
            android:textColor="#1C2420" android:textSize="14sp" android:textStyle="bold" />
        <FrameLayout android:id="@+id/w_mic" android:layout_width="44dp" android:layout_height="44dp">
            <ImageView android:id="@+id/w_mic_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:importantForAccessibility="no" />
            <ImageView android:id="@+id/w_mic_icon" android:layout_width="match_parent" android:layout_height="match_parent"
                android:contentDescription="@string/widget_tap_to_record" android:padding="11dp" android:src="@drawable/ic_widget_mic" />
        </FrameLayout>
    </LinearLayout>

    <TextView android:id="@+id/w_progress_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:fontFamily="@font/heebo" android:maxLines="1" android:textColor="#5B6660" android:textSize="12sp" />
    <ImageView android:id="@+id/w_progress" android:layout_width="match_parent" android:layout_height="8dp"
        android:layout_marginTop="4dp" android:importantForAccessibility="no" android:scaleType="fitXY" />

    <LinearLayout android:id="@+id/w_rows" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:background="@drawable/widget_card_calm_light" android:orientation="vertical"
        android:paddingStart="4dp" android:paddingEnd="8dp" />
    <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fontFamily="@font/heebo" android:gravity="center" android:text="@string/widget_nothing" android:textColor="#5B6660"
        android:textSize="15sp" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/w_footer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:ellipsize="end" android:fontFamily="@font/heebo" android:maxLines="2"
        android:textColor="#5B6660" android:textSize="12sp" />
</LinearLayout>
