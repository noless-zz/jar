<?xml version="1.0" encoding="utf-8"?>
<!-- Tasks widget, Night: a big count, a progress ring and the glowing orb; rows on a timeline. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg_night_dark" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="14dp" android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:id="@+id/w_head" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/plex_hebrew_regular" android:maxLines="1" android:textColor="#9AA6B5" android:textSize="12sp" />
            <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/plex_hebrew_bold" android:includeFontPadding="false" android:maxLines="1"
                android:textColor="#EEF2F6" android:textSize="34sp" />
            <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/plex_hebrew_regular" android:maxLines="1" android:textColor="#9AA6B5" android:textSize="12sp" />
        </LinearLayout>
        <FrameLayout android:layout_width="56dp" android:layout_height="56dp" android:layout_marginEnd="10dp">
            <ImageView android:id="@+id/w_progress" android:layout_width="match_parent" android:layout_height="match_parent"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/w_progress_text" android:layout_width="match_parent" android:layout_height="match_parent"
                android:fontFamily="@font/plex_hebrew_semibold" android:gravity="center" android:textColor="#EEF2F6" android:textSize="13sp" />
        </FrameLayout>
        <ImageView android:id="@+id/w_add" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="8dp"
            android:background="@drawable/widget_square_night_dark" android:contentDescription="@string/add_title" android:padding="10dp"
            android:src="@drawable/ic_widget_add" />
        <FrameLayout android:id="@+id/w_mic" android:layout_width="52dp" android:layout_height="52dp">
            <ImageView android:id="@+id/w_mic_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:importantForAccessibility="no" />
            <ImageView android:id="@+id/w_mic_icon" android:layout_width="match_parent" android:layout_height="match_parent"
                android:contentDescription="@string/widget_tap_to_record" android:padding="15dp" android:src="@drawable/ic_widget_mic" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/w_rows" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="vertical" />
    <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fontFamily="@font/plex_hebrew_regular" android:gravity="center" android:text="@string/widget_nothing"
        android:textColor="#9AA6B5" android:textSize="15sp" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/w_footer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:ellipsize="end" android:fontFamily="@font/plex_hebrew_regular" android:maxLines="1"
        android:textColor="#9AA6B5" android:textSize="12sp" />
</LinearLayout>
